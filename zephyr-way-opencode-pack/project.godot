; Zephyr Way — Godot project configuration
;
; Target: Godot 4.7.x, GDScript, Forward+ renderer (Linux desktop).
; See AGENTS.md for the technology contract and docs/ for workflow.

config_version=5

[application]

config/name="Zephyr Way"
config/description="Stylized low-poly arcade flight exploration."
config/version="0.1.0"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

; Autoloads are intentionally empty for milestone 1. Flight, camera and world
; services are scene-local nodes so nothing global is introduced before the
; design needs it (see AGENTS.md "Autoload only for genuinely global state").

[debug]

gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]

